# Copy to .env and fill in. .env is git-ignored; never commit real values.

# neatlogs Project API key: app.neatlogs.com -> Settings -> API keys (the top key).
# Not the HTTP ingest key that starts with nlw_ (the SDK returns 401 with it).
NEATLOGS_API_KEY=

# neatlogs LiteLLM gateway (the default model provider, OpenAI-compatible).
LITELLM_API_KEY=
# Optional. Defaults shown.
# LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
# LITELLM_MODEL=claude-sonnet-4.6
# Also offered: claude-opus-4.6, claude-haiku, nova-pro, nova-2-lite, nova-lite, nova-micro.

# Model provider: litellm (default) or codex.
# DTM_LLM_PROVIDER=litellm

# Optional, only with DTM_LLM_PROVIDER=codex. An OpenAI Platform API key for the Codex CLI, used instead of the
# ChatGPT sign-in (`codex login`). Leave empty when signed in.
CODEX_API_KEY=

# Optional. Everything below has a default suited to the local Docker stack.

# PostgreSQL. The defaults match docker-compose.yml.
# DTM_POSTGRES_PORT=5432
# DTM_DATABASE_URL=postgresql://dtm_admin:<password>@127.0.0.1:5432/datatracemind
# DTM_READONLY_DATABASE_URL=postgresql://dtm_readonly:<password>@127.0.0.1:5432/datatracemind

# Required on any public deployment: inject, investigate, approve, and reset
# then need this value in the X-Demo-Access-Code header.
# DTM_DEMO_ACCESS_CODE=

# Start an investigation automatically when an incident opens (spends model usage).
# DTM_AUTO_INVESTIGATE=0

# Caps on investigations started through the API.
# DTM_INVESTIGATIONS_PER_HOUR=6
# DTM_INVESTIGATIONS_PER_DAY=30
