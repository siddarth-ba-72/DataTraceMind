# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Gemini API key (the default model provider, run through Google's ADK):
# aistudio.google.com -> Get API key. GOOGLE_API_KEY is read as well.
GEMINI_API_KEY=
# Optional. Default shown: it fits the free tier. gemini-3.8-flash is the stronger
# model, but a free-tier key gets about 20 requests a day on it, and one
# investigation makes 10 to 15.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Also priced for cost estimates: gemini-3.8-flash, gemini-3.6-flash, gemini-3.1-flash-lite,
# gemini-3.1-pro-preview, gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite.

# Model provider: gemini (default), litellm, or codex.
# DTM_LLM_PROVIDER=gemini

# Only with DTM_LLM_PROVIDER=litellm: the neatlogs LiteLLM gateway (OpenAI-compatible).
LITELLM_API_KEY=
# LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
# LITELLM_MODEL=claude-sonnet-4.6
# Also offered: claude-opus-4.6, claude-haiku, nova-pro, nova-2-lite, nova-lite, nova-micro.

# Optional, only with DTM_LLM_PROVIDER=codex. An OpenAI Platform API key for the Codex CLI, used instead of the
# ChatGPT sign-in (`codex login`). Leave empty when signed in.
CODEX_API_KEY=

# PostgreSQL connection string (required). The app creates its schemas, seed
# data, and a read-only role named dtm_readonly in this database on first start,
# so this role must be allowed to create roles.
DTM_DATABASE_URL=

# Optional. Everything below has a default.

# Connection string of the read-only role the investigation tools use. By
# default it is the database above, signed in as dtm_readonly with a password
# derived from the one above.
# DTM_READONLY_DATABASE_URL=

# Server the tests create their datatracemind_test database on, when it should
# not be the one above.
# DTM_TEST_ADMIN_URL=

# Required on any public deployment: inject, investigate, approve, and reset
# then need this value in the X-Demo-Access-Code header.
# DTM_DEMO_ACCESS_CODE=

# Start an investigation automatically when an incident opens (spends model usage).
# DTM_AUTO_INVESTIGATE=0

# Caps on investigations started through the API.
# DTM_INVESTIGATIONS_PER_HOUR=6
# DTM_INVESTIGATIONS_PER_DAY=30
